# NVIDIA_API_KEY: Required for Nvidia AI API calls.
# Users configure this via the Secrets panel in the AI Studio UI.
NVIDIA_API_KEY="MY_NVIDIA_API_KEY"
# MOONSHOT_MODEL="moonshotai/kimi-k3"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FORTYGUARD CONFIGURATION (Server-side environmental data fabric)
# Never expose API keys to the browser.
FORTYGUARD_BASE_URL="https://api.fortyguard.com"
FORTYGUARD_API_KEY=""
FORTYGUARD_TIMEOUT=10000
FORTYGUARD_POLL_INTERVAL=1000
FORTYGUARD_MAX_POLL_TIME=30000
FORTYGUARD_RETRY_COUNT=3
FORTYGUARD_CACHE_TTL=300000
FORTYGUARD_MOCK=false


# PURPLEAIR_API_KEY=""
