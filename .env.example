# TABITOKEN CONFIGURATION (Exclusive AI Provider)
TABITOKEN_ENDPOINT="https://tabitoken.com/v1/chat/completions"
TABITOKEN_API_KEY="MY_TABITOKEN_API_KEY"
TABITOKEN_MODEL="claude-opus-4-8"
TABITOKEN_TIMEOUT=55000
TABITOKEN_MAX_RETRIES=1

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# FORTYGUARD CONFIGURATION (Server-side environmental data fabric)
FORTYGUARD_BASE_URL="https://api.fortyguard.com"
FORTYGUARD_API_KEY=""
FORTYGUARD_TIMEOUT=12000
FORTYGUARD_POLL_INTERVAL=1000
FORTYGUARD_MAX_POLL_TIME=30000
FORTYGUARD_RETRY_COUNT=3
FORTYGUARD_CACHE_TTL=300000
FORTYGUARD_MOCK=false
