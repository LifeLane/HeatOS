{
  "functions": {
    "api/**/*": {
      "runtime": "nodejs20.x",
      "maxDuration": 1200
    },
    "api/index.ts": {
      "runtime": "nodejs20.x",
      "maxDuration": 1200
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
